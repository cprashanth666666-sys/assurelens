# AssureLens — environment template.
# Copy to .env for local development. Never commit .env.

# ---- Database ----
POSTGRES_USER=assurelens
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=assurelens
DATABASE_URL=postgresql+psycopg://assurelens:change-me-locally@postgres:5432/assurelens

# ---- Backend ----
# Origin allowed to call the API. Locked down, not "*".
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Base URL of the deliberately-vulnerable target service that suite 3 probes.
# It is reached over HTTP only — the backend never imports it. [TRD 1.2]
TARGET_SERVICE_URL=http://target_service:8001

# Deterministic seeding. Every run records the seed it used. [TRD 3.4]
DEFAULT_SEED=42

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
