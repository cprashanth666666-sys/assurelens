# AssureLens — environment template.
# Copy to .env for local development. Never commit .env.

# ---- Database ----
POSTGRES_USER=assurelens
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=assurelens
DATABASE_URL=postgresql+psycopg://assurelens:change-me-locally@postgres:5432/assurelens

# ---- Backend ----
# Origin allowed to call the API. Locked down, not "*".
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Base URL of the deliberately-vulnerable target service that suite 3 probes.
# It is reached over HTTP only — the backend never imports it. [TRD 1.2]
TARGET_SERVICE_URL=http://target_service:8001

# Deterministic seeding. Every run records the seed it used. [TRD 3.4]
DEFAULT_SEED=42

# ---- Frontend ----
# BUILD-TIME ONLY. Next.js inlines NEXT_PUBLIC_* into the client bundle during
# `next build`; it is never read at runtime. Set as a runtime-only variable on
# a host, it has no effect and the localhost fallback ships to every visitor —
# their browser then probes port 8000 on their own machine. The production
# build refuses to proceed without it (see frontend/next.config.mjs).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
